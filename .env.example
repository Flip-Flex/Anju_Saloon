# ---------------------------------------------------------------------------
# Anju Saloon — frontend environment template (Vite)
# Copy this file to `.env` and fill in the real values:
#   cp .env.example .env
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# ---------------------------------------------------------------------------

# Firebase web app configuration (src/lib/firebase.ts)
# Find these under: Firebase Console -> Project settings -> Your apps -> SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: custom SMS gateway endpoint used by Billing.tsx.
# Leave empty to fall back to http://localhost:5000/send-sms in dev and
# /api/send-sms in production (both fail gracefully with a toast if absent).
# VITE_SMS_API_URL=
