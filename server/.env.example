# ---------------------------------------------------------------------------
# Anju Saloon — OPTIONAL server environment (server/server.js)
#
# ⚠️ server/server.js is RETIRED: nothing in the app runs or calls it.
#    Create this file only if you ever want to start it manually for:
#      - server-side bill price validation (Firebase Admin), or
#      - real SMS sending (Twilio).
# Copy to `server/.env` and fill in what you need:
#   cp server/.env.example server/.env
# Then run it with:  node server/server.js   (listens on PORT, default 5000)
# ---------------------------------------------------------------------------

# Port the Express server listens on
PORT=5000

# Public URL used to build bill links inside SMS messages
VITE_APP_URL=https://anjussaloon.web.app

# Firebase Admin service account (JSON key) as a SINGLE-LINE JSON string.
# Only needed for secure price validation + stock deduction.
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Twilio credentials for real SMS delivery (see TWILIO_WHATSAPP_SETUP.md)
# TWILIO_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
